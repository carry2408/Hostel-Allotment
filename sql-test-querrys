-- // 30 rooms info

INSERT INTO rooms (block, room_number, type, fee, capacity)
SELECT 
  CASE 
    WHEN n <= 10 THEN 'R'
    WHEN n <= 20 THEN 'S'
    ELSE 'N'
  END,
  LPAD(n, 3, '0'),
  IF(n % 3 = 0, 'single', 'double'),
  IF(n % 3 = 0, 40000, 50000),
  IF(n % 3 = 0, 1, 2)
FROM (
  SELECT 1 n UNION SELECT 2 UNION SELECT 3 UNION SELECT 4 UNION SELECT 5
  UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION SELECT 9 UNION SELECT 10
  UNION SELECT 11 UNION SELECT 12 UNION SELECT 13 UNION SELECT 14 UNION SELECT 15
  UNION SELECT 16 UNION SELECT 17 UNION SELECT 18 UNION SELECT 19 UNION SELECT 20
  UNION SELECT 21 UNION SELECT 22 UNION SELECT 23 UNION SELECT 24 UNION SELECT 25
  UNION SELECT 26 UNION SELECT 27 UNION SELECT 28 UNION SELECT 29 UNION SELECT 30
) t;


-- student details 25 

INSERT INTO students (usn, email, password_hash, cgpa, doc_url, status)
SELECT 
  CONCAT('1MS24CS', LPAD(n, 3, '0')),
  CONCAT('s', n, '@mail.com'),
  '$2b$10$wavmlir1puUfTzPNuaxcj.GEAEVdNog0zUfMBhdg4t7TIABZ6PtaK',
  ROUND(
    CASE 
      WHEN n <= 5 THEN 9 + RAND()
      WHEN n <= 10 THEN 8 + RAND()
      WHEN n <= 15 THEN 7 + RAND()
      WHEN n <= 20 THEN 6 + RAND()
      ELSE 5 + RAND()
    END, 2
  ),
  'doc',
  'pending'
FROM (
  SELECT 1 n UNION SELECT 2 UNION SELECT 3 UNION SELECT 4 UNION SELECT 5
  UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION SELECT 9 UNION SELECT 10
  UNION SELECT 11 UNION SELECT 12 UNION SELECT 13 UNION SELECT 14 UNION SELECT 15
  UNION SELECT 16 UNION SELECT 17 UNION SELECT 18 UNION SELECT 19 UNION SELECT 20
  UNION SELECT 21 UNION SELECT 22 UNION SELECT 23 UNION SELECT 24 UNION SELECT 25
) t;

--  application

INSERT INTO applications (student_id, year, submitted_at, is_locked)
SELECT 
  id,
  '2026',
  TIMESTAMP('2026-01-01 10:00:00') + INTERVAL id MINUTE,
  TRUE
FROM students;